{
  "seed": 42,
  "data": {
    "train_annotations": "../data/scanqa/ScanQA_v1.0_train.json",
    "val_annotations": "../data/scanqa/ScanQA_v1.0_val.json",
    "scene_cache": "cache/scene_objects.pt",
    "text_cache": "cache/text_embeddings.pt"
  },
  "model": {
    "hidden_dim": 256,
    "num_layers": 2,
    "num_heads": 4,
    "dropout": 0.1,
    "max_count": 25
  },
  "training": {
    "device": "cuda",
    "amp": true,
    "batch_size": 64,
    "epochs": 20,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "count_loss_weight": 0.25,
    "ranking_loss_weight": 0.1,
    "ranking_margin": 0.5,
    "gradient_clip": 1.0,
    "patience": 5,
    "num_workers": 4,
    "output_dir": "runs"
  }
}